# ------------------------------------------------------------------
# Copie este arquivo para .env e preencha com os valores reais.
#   cp .env.example .env
# NUNCA comite o .env.
# ------------------------------------------------------------------

# --- Aplicacao ---
APP_ENV=development
PORT=5000
LOG_LEVEL=INFO

# --- Evolution API ---
# URL base da sua instancia da Evolution API (sem barra no final).
# Dev local (Evolution rodando solta): http://localhost:8080
# Producao (docker-compose deste projeto, tudo na mesma rede): http://evolution:8080
EVOLUTION_API_URL=http://localhost:8080
# Chave global/mestre (apikey) configurada na Evolution API - autoriza
# operacoes em qualquer instancia (cada cliente cadastrado tem a sua).
EVOLUTION_API_KEY=coloque_sua_api_key_aqui

# --- Infra da Evolution API (Postgres + Redis, usados pelo docker-compose) ---
POSTGRES_PASSWORD=troque_por_uma_senha_forte

# --- Banco de dados dos clientes (mesmo Postgres da Evolution, schema "bot") ---
# Role dedicado, sem acesso as tabelas internas da Evolution. Depois de definir
# BOT_DB_PASSWORD, rode uma vez (novo Postgres = novo bootstrap):
#   docker compose exec bot python scripts/bootstrap_db.py
BOT_DB_PASSWORD=troque_por_outra_senha_forte
DATABASE_URL=postgresql://bot_app:${BOT_DB_PASSWORD}@postgres:5432/evolution

# --- Dominio publico da Evolution API (Caddy faz o HTTPS automatico) ---
# Aponte um registro A desse dominio para o IP publico da VPS antes de subir o compose.
EVOLUTION_DOMAIN=evolution.seudominio.com.br

# --- Seguranca do webhook ---
# Token arbitrario; a Evolution deve enviar em X-Webhook-Token.
# Deixe vazio para desativar a validacao (nao recomendado em producao).
WEBHOOK_TOKEN=

# --- Notificacoes por e-mail (cliente pediu para falar com atendente) ---
# Caixa de saida compartilhada por todos os clientes; o destinatario de cada
# um fica cadastrado no proprio cliente (ver scripts/gerenciar_clientes.py).
# Gmail: gere uma "senha de app" em myaccount.google.com/apppasswords
# (precisa de verificacao em duas etapas ativada na conta).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
